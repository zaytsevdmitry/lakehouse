{
  "keyName": "spark",
  "description": "Spark job scenario",
  "tasks": [
    {
      "name": "check",
      "template": "checkTemplate"
    },
    {
      "name": "begin",
      "taskExecutionServiceGroupName": "default",
      "taskProcessor": "lockedStateTaskProcessor",
      "importance": "critical",
      "description": "Made interval status LOCKED"
    },
    {
      "name": "prepare",
      "template": "spark",
      "taskProcessorBody": "createTableSQLProcessorBody",
      "description": "Prepare table if need"
    },
    {
      "name": "load",
      "template": "spark",
      "taskProcessorBody": "mergeSQLProcessorBody",
      "description": "load from current datastore"
    },
    {
      "name": "compact",
      "template": "spark",
      "taskProcessorBody": "compactTableSQLProcessorBody",
      "description": "Compact when need"
    },
    {
      "name": "finally",
      "taskExecutionServiceGroupName": "default",
      "taskProcessor": "successStateTaskProcessor",
      "importance": "critical",
      "description": "DataSet success"
    }
  ],
  "dagEdges": [
    {
      "from": "check",
      "to": "begin"
    },
    {
      "from": "begin",
      "to": "prepare"
    },
    {
      "from": "prepare",
      "to": "load"
    },
    {
      "from": "load",
      "to": "compact"
    },
    {
      "from": "compact",
      "to": "finally"
    }
  ]
}
