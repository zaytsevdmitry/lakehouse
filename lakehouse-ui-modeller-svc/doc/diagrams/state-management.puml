@startuml
title Frontend — state ownership
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam dpi 150

package "App.jsx — global (session-scoped) state" {
  map "profile" as prof {
    username => + /v1_0/auth/me
    roles => server session (Keycloak claims)
    effectiveRole => viewer | editor | admin
  }
  map "openWorkspace" as ow {
    id => + /v1_0/vcs/workspace
    branch => ""
  }
  map "notice" as ntf {
    kind => success | error
    message => transient banner
  }
  map "theme" as thm {
    light | dark => localStorage "lakehouse-modeller-theme"
  }
  map "session" as ses {
    owner => server (JSESSIONID cookie)
    frontend => none (no tokens in localStorage)
  }
}
prof --> ses : resolved through server session
thm --> ses : independent of auth state

package "EditorView — per-file local state" {
  map "tree" as tree {
    entries => /workspaces/{id}/tree
  }
  map "selected" as sel {
    entry => {path, kind, keyName, isKeyNameEditable}
  }
  map "doc / yaml" as doc {
    parse => parseYaml
    serialize => stringifyYaml
  }
  map "mode" as mode {
    form => "FormEditor"
    yaml => "textarea"
  }
  map "dirty / busy / modals" as dbm {
    flags => new/save/delete/review modals
  }
}
tree --> api : /workspaces/{id}/tree
sel --> doc : openFile (GET /files/{path})
mode --> doc : form <-> raw switch
dbm --> api : save / delete / review

package "Graph editors — module-level" {
  map "nodePositions" as npos {
    scope => "per session, in-memory Map"
    owners => DagEditor, ErDiagramEditor
  }
}

package "AdminView — local state" {
  map "workspaces / logs" as aws {
    lists => admin workspaces, sync logs
  }
}
aws --> api : /v1_0/admin/*

note bottom
  No global store: state is passed top-down as props.
  Session is owned server-side (JSESSIONID cookie); the
  frontend never stores tokens. Inactivity after 30 min
  issues POST /logout and reloads "/".
end note
@enduml