@startuml
title Review submission — commit, push, MR/PR
skinparam sequenceMessageAlign center
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam dpi 150

actor UI
participant "VcsController" as V
participant "ReviewService" as R
participant "WorkspaceManager" as M
participant "WorkspaceStorage" as ST
participant "VcsProvider" as P
participant "Git hosting" as G

UI -> V: POST /v1_0/vcs/review/{workspaceId}
activate V
V -> R: submit(workspaceId, request, auth)
activate R
R -> R: requireEditor(auth)
R -> R: ownership check (owner or ADMIN)
R -> M: synchronizedOn(workspaceId) — lock workspace
activate M
M --> R: lock acquired
deactivate M
R -> ST: readAll(workspaceId)
activate ST
ST --> R: {path -> yaml} (reconciled)
deactivate ST
R -> P: submitReview(files, user)
activate P

alt local-git
  P -> G: JGit commit + push refs/heads/<branch>
else gerrit
  P -> G: JGit commit + push refs/for/<branch>
else gitlab-api
  P -> G: REST commit + open Merge Request
else github-app
  P -> G: install access token, push, open Pull Request
end

G --> P: ok / PR(MR) url
P --> R: VcsReviewResult(status, url)
deactivate P

R -> M: deleteWorkspace(workspaceId)
activate M
M --> R: ok
deactivate M
R -> R: SyncLogService.log("REVIEW", ...)
R --> V: ReviewResponse(status, url)
deactivate R
V --> UI: 200 ReviewResponse
deactivate V
@enduml