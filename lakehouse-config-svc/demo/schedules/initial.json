{
  "keyName": "initial",
  "description": "initial schedule for client transactions",
  "intervalExpression": "0 0 1 1 * *",
  "startDateTime": "2020-12-31T21:00:00.000+00:00",
  "stopDateTime": null,
  "enabled": true,
  "scenarioActs": [
    {
      "name": "transaction_processing",
      "dataSetKeyName": "transaction_processing",
      "intervalStart": "{{ adddays(targetDateTimeTZ, -1) }}",
      "intervalEnd": "{{ targetDateTimeTZ }}",
      "scenarioActTemplate": "default",
      "tasks": [
        {
          "name": "begin",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "lockedStateTaskProcessor",
          "importance": "critical",
          "description": "Made interval status RUNNING"
        },
        {
          "name": "prepare",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "jdbcTaskProcessor",
          "taskProcessorBody": "createTableSQLProcessorBody",
          "importance": "critical",
          "driverKeyName": "postgres",
          "description": "Create table if not exists",

          "taskProcessorArgs": {
          }
        },
        {
          "name": "load",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "jdbcTaskProcessor",
          "taskProcessorBody": "appendSQLProcessorBody",
          "importance": "critical",
          "description": "override load",
          "taskProcessorArgs": {
            "spark.executor.memory": "1g",
            "spark.executor.cores": "2"
          }
        },
        {
          "name": "success",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "successStateTaskProcessor",
          "importance": "critical",
          "description": "DataSet success"
        }
      ],
      "dagEdges": [
        {
          "from": "begin",
          "to": "prepare"
        },
        {
          "from": "prepare",
          "to": "load"
        },
        {
          "from": "load",
          "to": "success"
        }
      ]
    },
    {
      "name": "client_processing",
      "dataSetKeyName": "client_processing",
      "scenarioActTemplate": "default",
      "intervalStart": "{{ adddays(targetDateTimeTZ, -1) }}",
      "intervalEnd": "{{ targetDateTimeTZ }}",
      "tasks": [
        {
          "name": "begin",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "lockedStateTaskProcessor",
          "importance": "critical",
          "description": "Made interval status RUNNING"
        },
        {
          "name": "prepare",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "jdbcTaskProcessor",
          "taskProcessorBody": "createTableSQLProcessorBody",
          "importance": "critical",
          "description": "Create table if not exists",
          "driverKeyName" : "postgres",
          "taskProcessorArgs": {
          }
        },
        {
          "name": "load",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "jdbcTaskProcessor",
          "taskProcessorBody": "mergeSQLProcessorBody",
          "importance": "critical",
          "description": "override load",
          "taskProcessorArgs": {
            "spark.executor.memory": "1g",
            "spark.executor.cores": "2"
          }
        },
        {
          "name": "success",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "successStateTaskProcessor",
          "importance": "critical",
          "description": "DataSet success"
        }
      ],
      "dagEdges": [
        {
          "from": "begin",
          "to": "prepare"
        },
        {
          "from": "prepare",
          "to": "load"
        },
        {
          "from": "load",
          "to": "success"
        }
      ]
    },
    {
      "name": "transaction_dds",
      "dataSetKeyName": "transaction_dds",
      "scenarioActTemplate": "spark",
      "intervalStart": "{{ adddays(targetDateTimeTZ, -1) }}",
      "intervalEnd": "{{ targetDateTimeTZ }}",
      "tasks": [
        {
          "name": "extend",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "sparkStandAloneClusterTaskProcessor",
          "taskProcessorBody": "mergeSQLProcessorBody",
          "importance": "critical",
          "description": "Not exists in template",
          "driverKeyName": "spark_iceberg",
          "taskProcessorArgs": {
            "spark.executor.memory": "5g",
            "spark.driver.memory": "2g"
          }
        },
        {
          "name": "load",
          "taskExecutionServiceGroupName": "default",
          "taskProcessor": "sparkStandAloneClusterTaskProcessor",
          "taskProcessorBody": "mergeSQLProcessorBody",
          "importance": "critical",
          "description": "override load",
          "taskProcessorArgs": {
            "spark.executor.memory": "1g",
            "spark.driver.memory": "2g",
            "spark.executor.cores": "2"
          }
        }
      ],
      "dagEdges": [
        {
          "from": "extend",
          "to": "load"
        }
      ]
    },
    {
      "name": "aggregation_pay_per_client_daily_mart",
      "dataSetKeyName": "aggregation_pay_per_client_daily_mart",
      "scenarioActTemplate": "spark",
      "intervalStart": "{{ adddays(targetDateTimeTZ, -1) }}",
      "intervalEnd": "{{ targetDateTimeTZ }}"
    },
    {
      "name": "aggregation_pay_per_client_total_mart",
      "dataSetKeyName": "aggregation_pay_per_client_total_mart",
      "scenarioActTemplate": "spark",
      "intervalStart": "{{ adddays(targetDateTimeTZ, -1) }}",
      "intervalEnd": "{{ targetDateTimeTZ }}"
    }
  ],
  "scenarioActEdges": [
    {
      "from": "transaction_processing",
      "to": "transaction_dds"
    },
    {
      "from": "client_processing",
      "to": "transaction_dds"
    },
    {
      "from": "transaction_dds",
      "to": "aggregation_pay_per_client_daily_mart"
    },
    {
      "from": "transaction_dds",
      "to": "aggregation_pay_per_client_total_mart"
    }
  ]
}
