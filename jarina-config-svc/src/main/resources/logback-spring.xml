<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="AUDIT_CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"log_type":"audit", "service":"jarina-config-svc"}</customFields>
        </encoder>
    </appender>

    <springProperty scope="context" name="auditLogFile" source="jarina.security.audit.log-file" defaultValue="logs/audit.log"/>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${auditLogFile}</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="AUDIT_LOG" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_CONSOLE_JSON"/>
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
