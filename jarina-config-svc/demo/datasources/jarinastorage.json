{
  "keyName": "jarinastorage",
  "domainKeyName": "DEMO",
  "service":
    {
      "host": "localhost",
      "port": "6066",
      "urn": "",
      "properties": {
        "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
        "spark.sql.catalog.jarinastorage": "org.apache.iceberg.spark.SparkCatalog",
        "spark.sql.catalog.jarinastorage.type": "hadoop",
        "spark.sql.catalog.jarinastorage.warehouse": "$PWD/warehouse"
      }
    },
  "description": "Local datastore",
  "dataSourceType" : "iceberg",
  "databaseProtocol": "s3"
}
