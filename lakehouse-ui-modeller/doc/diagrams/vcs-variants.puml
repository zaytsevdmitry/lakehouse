@startuml
title VCS integration variants (lakehouse.configurator.vcs-provider)
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam dpi 150

[VcsProviderFactory] as F

F --> [LocalGitVcsProvider] : local-git\n(direct / local repo)
F --> [LocalGitVcsProvider] : gerrit\n(Gerrit review push)
F --> [GitLabApiVcsProvider] : gitlab-api
F --> [GitHubAppVcsProvider] : github-app
F --> [DisabledVcsProvider] : none / empty

[LocalGitVcsProvider] as LG
[GitLabApiVcsProvider] as GL
[GitHubAppVcsProvider] as GH

package "Local / Gerrit (JGit transport)" {
  [SSH or HTTPS remote\nrefs/heads or refs/for push] as lgt
}
package "GitLab (REST API v4)" {
  [Merge Requests] as glmr
}
package "GitHub (App + REST API)" {
  [Pull Requests] as ghmr
}

LG --> lgt : system account\nssh | token | basic
GL --> glmr : PAT token\n(vcs-system-account.token)
GH --> ghmr : App JWT ->\ninstallation token

note bottom of LG
  required: git.remote-url, vcs-system-account
  (auth-type ssh|token|basic)
  gerrit: refs/for/<branch> for review
end note
note bottom of GL
  required: git.remote-url (group/repo),
  vcs-system-account.auth-type=token,
  vcs-system-account.token
end note
note bottom of GH
  required: git.remote-url (owner/repo),
  github.app-id, github.app-private-key-path,
  github.installation-id
  (vcs-system-account optional fallback)
end note
@enduml