<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
    </parent>
    <groupId>yarina</groupId>
    <artifactId>yarina-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>yarina-common</module>
        <module>yarina-config-svc</module>
        <module>yarina-config-rest-client</module>
        <module>yarina-scheduler-rest-client</module>
        <module>yarina-scheduler-svc</module>
        <module>yarina-state-rest-client</module>
        <module>yarina-task-executor-svc</module>
        <module>yarina-ui-svc</module>
        <module>yarina-cli</module>
        <module>yarina-common-test</module>
        <module>yarina-common-rest-client</module>
        <module>yarina-common-health</module>
        <module>yarina-domain-api</module>
        <module>yarina-state-svc</module>
        <module>yarina-jinjava</module>
        <module>yarina-task-executor-rest-client</module>
        <module>yarina-spark-rest-client</module>
        <module>yarina-task-executor-api</module>
        <module>yarina-validators</module>
        <module>yarina-task-executor-spark-api</module>
        <module>yarina-task-executor-spark-dataset-app</module>
        <module>yarina-task-executor-spark-dq-app</module>
        <module>yarina-task-proxy-for-spark</module>
        <module>yarina-task-proxy-for-spark-api</module>
        <module>yarina-task-proxy-for-spark-rest-client</module>
        <module>yarina-credential-providers-jdbc</module>
        <module>yarina-credential-providers-spark</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <properties>
        <revision>1.1.0</revision>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <springdoc.version>3.1.0</springdoc.version>
        <kafka.testcontainers.version>1.19.3</kafka.testcontainers.version>
        <jgit.version>6.7.0.202309050840-r</jgit.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
