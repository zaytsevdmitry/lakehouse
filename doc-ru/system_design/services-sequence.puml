@startuml
autonumber

queue schedule_effective_changes
queue scheduled_task_msg

"conf-svc" -> schedule_effective_changes : publish ScheduleEffectiveDTO
schedule_effective_changes -> "scheduler-svc" : consume ScheduleEffectiveDTO

"scheduler-svc" -> "conf-svc" : request task details TaskDTO getEffectiveTaskDTO
"scheduler-svc" -> scheduled_task_msg : publish ScheduledTaskMsgDTO
scheduled_task_msg -> "task-executor-svc" : consume ScheduledTaskMsgDTO

"task-executor-svc" -> "scheduler-svc" : lockTaskById ScheduledTaskMsgDTO.id
"scheduler-svc" -> "task-executor-svc" : response ScheduledTaskLockDTO with task details or error
"task-executor-svc" -> "conf-svc" : request source configuration SourceConfDTO getSourceConfDTO
"task-executor-svc" -> "state-svc" : set LOCKED state DataSetStateDTO
"task-executor-svc" -> "task-proxy-for-spark" : spark submit REST /v1/submissions (for spark tasks)
"task-executor-svc" -> "state-svc" : set SUCCESS state DataSetStateDTO
"task-executor-svc" -> "scheduler-svc" : send TaskExecutionHeartBeatDTO
"task-executor-svc" -> "scheduler-svc" : send TaskInstanceReleaseDTO to release lock
"cli" <- "scheduler-svc" : get tasks info ScheduledTaskDTO
@enduml