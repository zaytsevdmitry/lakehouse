@startuml
title Scheduler — spark_submissions claim → execute → complete

skinparam backgroundColor #FEFEFE
skinparam sequenceArrowThickness 1

participant "Scheduler\n(@Scheduled 5s)" as Sched
database "PostgreSQL" as PG
participant "Adapter\n(Local / Standalone / K8s / YARN / MESOS)" as Adapter
participant "spark-submit\n(ProcessBuilder)" as SparkCLI
participant "Cluster" as Cluster

== poll() start ==

Sched -> Sched : log.info("Scheduler poll start")

== 1. claimTask — FOR UPDATE SKIP LOCKED ==

Sched -> PG : claimTask(instanceId)

note right of PG
  UPDATE spark_submissions SET status='CLAIMED', claimed_by=:instanceId, claimed_at=now()
  WHERE id=(SELECT id FROM spark_submissions WHERE status='QUEUED' ORDER BY created_at ASC FOR UPDATE SKIP LOCKED LIMIT 1)
  RETURNING id, submission_id, cluster_type, app_resource, main_class, namespace, spark_properties
end note

alt row == null (nothing to claim)

    PG --> Sched : null
    Sched -> Sched : return (idle)

else row returned

    PG --> Sched : row=(42, null, "kubernetes", "app.jar", "com.Main", null, "{...}")
    Sched -> Sched : id=row[0]=42, appResource=row[3]="app.jar", mainClass=row[4]="com.Main", sparkProperties=row[6]="{...}"
    Sched -> Sched : log.info("Claimed task id=42 on instance={}", instanceId)

end

== 2. Deserialize sparkProperties ==

Sched -> Sched : deserializeProperties(sparkProperties) → Map<String,String>

== 3. Build CreateSubmissionRequest ==

Sched -> Sched : new CreateSubmissionRequest(null, null, "app.jar", null, "com.Main", {spark.master:"k8s://...", ...}, null)

== 4. createSubmission ==

Sched -> Adapter : adapter.createSubmission(request)
Adapter -> Adapter : submissionId = "driver-" + UUID ("driver-abc-123")
Adapter -> Adapter : buildSparkSubmitCommand(): spark-submit --conf spark.master=k8s://... --class com.Main app.jar
Adapter -> SparkCLI : pb.start() + process.waitFor()
SparkCLI -> Cluster : Submit job to cluster (spark-submit launches driver)

alt exitCode == 0

    SparkCLI --> Adapter : exitCode = 0
    Adapter -> Adapter : log.info("spark-submit completed successfully. submissionId=driver-abc-123")
    Adapter --> Sched : submissionId = "driver-abc-123"

    == 5a. completeTask — SUBMITTED ==

    Sched -> PG : completeTask(42, "driver-abc-123", "SUBMITTED", "spark-submit launched successfully")

    note right of PG
      UPDATE spark_submissions
      SET submission_id='driver-abc-123', status='SUBMITTED', message='spark-submit launched successfully'
      WHERE id=42
    end note

    PG --> Sched : void
    Sched -> Sched : log.info("Task id=42 submitted. submissionId=driver-abc-123")

else exitCode != 0

    SparkCLI --> Adapter : exitCode = 1
    Adapter -> Adapter : log.error("spark-submit failed with exit code 1. Output: ...")
    Adapter -> Adapter : throw RuntimeException("spark-submit failed (exit 1): ...")
    Adapter --> Sched : RuntimeException

    == 5b. completeTask — FAILED ==

    Sched -> Sched : log.error("Scheduler poll error for task id=42", e)
    Sched -> PG : completeTask(42, null, "FAILED", "spark-submit failed (exit 1): ...")

    note right of PG
      UPDATE spark_submissions
      SET submission_id=null, status='FAILED', message='spark-submit failed (exit 1): ...'
      WHERE id=42
    end note

    PG --> Sched : void
    Sched -> Sched : log.error("Failed to mark task id=42 as FAILED")

end

== poll() end ==

@enduml
